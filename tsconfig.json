{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@vorra/core": ["packages/core/src/index.ts"],
      "@vorra/compiler": ["packages/compiler/src/index.ts"],
      "@vorra/cli": ["packages/cli/src/index.ts"],
      "@vorra/router": ["packages/router/src/index.ts"],
      "@vorra/forms": ["packages/forms/src/index.ts"]
    }
  },
  "exclude": ["**/node_modules", "**/dist"]
}

<script lang="ts">
import { signal, computed } from '@forge/core';

const name = signal('World');
const greeting = computed(() => `Hello, ${name()}!`);

function onInput(e: Event) {
  name.set((e.target as HTMLInputElement).value);
}
</script>

<template>
  <div style="margin-bottom: 2rem;">
    <p style="font-size: 1.5rem; font-weight: bold; margin-bottom: 1rem; color: #333;">
      {greeting()}
    </p>
    <input
      type="text"
      placeholder="Enter your name"
      style="padding: 0.5rem 1rem; font-size: 1rem; border: 2px solid #ddd; border-radius: 6px; outline: none;"
      @input={onInput}
    />
  </div>
</template>

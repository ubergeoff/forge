<script lang="ts">
import { signal, computed } from '@forge/core';

const name = signal('World');
const greeting = computed(() => `Hello, ${name()}!`);

function onInput(e: Event) {
  name.set((e.target as HTMLInputElement).value);
}
</script>

<template>
  <div class="mb-8">
    <p class="text-2xl font-bold text-gray-800 mb-3">{greeting()}</p>
    <input
      type="text"
      placeholder="Enter your name"
      class="px-4 py-2 text-base border-2 border-gray-300 rounded-lg outline-none focus:border-blue-500 transition-colors"
      @input={onInput}
    />
  </div>
</template>

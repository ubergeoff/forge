<script lang="ts">
import { signal } from '@vorra/core';

const count = signal(0);

function increment() { count.update(n => n + 1); }
function reset() { count.set(0); }
</script>

<template>
  <div class="flex flex-col items-center gap-4">
    <p class="text-6xl font-bold text-gray-900 tabular-nums">{count()}</p>
    <div class="flex gap-3">
      <button
        class="px-6 py-2 text-base font-medium rounded-lg bg-gray-900 text-white hover:bg-gray-700 cursor-pointer transition-colors"
        @click={increment}
      >
        Click me
      </button>
      <button
        class="px-6 py-2 text-base font-medium rounded-lg border-2 border-gray-300 bg-white text-gray-700 hover:bg-gray-50 cursor-pointer transition-colors"
        @click={reset}
      >
        Reset
      </button>
    </div>
  </div>
</template>

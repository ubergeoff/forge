{
  "name": "@vorra/compiler",
  "version": "0.3.0",
  "description": "Vorra compiler — .vorra SFC parser and template compiler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubergeoff/vorra.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/ubergeoff/vorra/tree/main/packages/compiler#readme",
  "keywords": [
    "vorra",
    "compiler",
    "sfc",
    "template",
    "framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vorra/core": "*",
    "oxc-transform": "^0.121.0"
  },
  "peerDependencies": {
    "postcss": ">=8.4.0",
    "sass": ">=1.57.0"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "sass": {
      "optional": true
    }
  },
  "devDependencies": {
    "rolldown": "*",
    "sass": "*",
    "typescript": "*"
  },
  "sideEffects": false
}

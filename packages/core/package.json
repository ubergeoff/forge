{
  "name": "@vorra/core",
  "version": "0.3.0",
  "description": "Vorra core — reactivity primitives and dependency injection",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubergeoff/vorra.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ubergeoff/vorra/tree/main/packages/core#readme",
  "keywords": [
    "vorra",
    "signals",
    "reactivity",
    "dependency-injection",
    "framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./reactivity": {
      "import": "./dist/reactivity.js",
      "require": "./dist/reactivity.cjs",
      "types": "./dist/reactivity.d.ts"
    },
    "./di": {
      "import": "./dist/di.js",
      "require": "./dist/di.cjs",
      "types": "./dist/di.d.ts"
    },
    "./dom": {
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs",
      "types": "./dist/dom.d.ts"
    }
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "rolldown": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "sideEffects": false
}

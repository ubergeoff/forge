{
  "name": "@forge/router",
  "version": "0.2.0",
  "description": "Forge router — signal-driven client-side routing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubergeoff/forge.git",
    "directory": "packages/router"
  },
  "homepage": "https://github.com/ubergeoff/forge/tree/main/packages/router#readme",
  "keywords": [
    "forge",
    "router",
    "signals",
    "client-side-routing",
    "framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@forge/core": "*"
  },
  "devDependencies": {
    "rolldown": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "sideEffects": false
}
